// Banco de dados: Postgres gratuito do Supabase.
// "url" usa a connection pooling (porta 6543) - necessária para funções
// serverless da Vercel. "directUrl" usa a conexão direta (porta 5432),
// exigida pelo Prisma só na hora de rodar migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  avatarColor  String    @default("blue") @map("avatar_color")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")

  // preparado para status online/offline no futuro
  isOnline     Boolean   @default(false) @map("is_online")
  lastSeenAt   DateTime? @map("last_seen_at")

  // Conta admin oculta: some das listas de usuários/participantes e tem
  // poder de apagar qualquer usuário, conversa, mensagem ou participante.
  isGhost      Boolean   @default(false) @map("is_ghost")

  memberships  ConversationMember[]
  messages     Message[]
  hiddenMessages MessageHiddenFor[]

  @@map("users")
}

// Conversa privada (1 para 1) ou grupo (isGroup = true)
model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false) @map("is_group")
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

// Quem participa de qual conversa
model ConversationMember {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  conversationId String    @map("conversation_id")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  isAdmin        Boolean   @default(false) @map("is_admin")

  // quando não-nulo, a conversa fica escondida da lista desse usuário
  // (equivalente ao "apagar para mim" do WhatsApp) até chegar mensagem nova
  hiddenAt       DateTime? @map("hidden_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid())
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  // preparado para funcionalidades futuras
  type           String   @default("text")
  fileUrl        String?  @map("file_url")
  isEdited       Boolean  @default(false) @map("is_edited")

  senderId       String   @map("sender_id")
  conversationId String   @map("conversation_id")

  // mensagem sendo respondida (estilo WhatsApp) - se ela for apagada, a
  // resposta continua existindo, só perde a citação (por isso SetNull).
  replyToId      String?  @map("reply_to_id")
  replyTo        Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReplies")

  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  hiddenFor    MessageHiddenFor[]

  @@map("messages")
}

// Configurações globais do site - sempre uma única linha (id fixo em 1).
model AppSettings {
  id                  Int     @id @default(1)
  registrationEnabled Boolean @default(true) @map("registration_enabled")

  @@map("app_settings")
}

// Quando alguém escolhe "apagar para mim" numa mensagem específica, cria
// uma linha aqui - a mensagem continua existindo pra todo mundo, só
// desaparece da lista de quem apagou.
model MessageHiddenFor {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  hiddenAt  DateTime @default(now()) @map("hidden_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_hidden_for")
}
